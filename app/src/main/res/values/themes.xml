<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Maleem" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/gold</item>
        <item name="android:windowBackground">@color/app_bg</item>
    </style>

    <!-- Splash: the round Maleem icon on the app background, kept on screen until the page has drawn -->
    <style name="Theme.Maleem.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Maleem</item>
    </style>
</resources>
