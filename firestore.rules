rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function spacePath(code) {
      return /databases/$(database)/documents/spaces/$(code);
    }

    function requestPath(code, uid) {
      return /databases/$(database)/documents/spaces/$(code)/joinRequests/$(uid);
    }

    function memberPath(code, uid) {
      return /databases/$(database)/documents/spaces/$(code)/members/$(uid);
    }

    function spaceExists(code) {
      return exists(spacePath(code));
    }

    function isSpaceMember(code) {
      return signedIn()
        && spaceExists(code)
        && get(spacePath(code)).data.memberIds is list
        && get(spacePath(code)).data.memberIds.hasAny([request.auth.uid]);
    }

    function isSpaceOwner(code) {
      return signedIn()
        && spaceExists(code)
        && get(spacePath(code)).data.owner == request.auth.uid;
    }

    // Record ids are generated by the app (letters, digits, "_" and "-"). Anything else (quotes, "<", ">")
    // is refused so a member can't plant HTML in other members' phones through a document id.
    function validId(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    function validJoinName(name) {
      return name is string && name.size() > 0 && name.size() <= 24;
    }

    function validSharePrefs(prefs) {
      return prefs is map
        && prefs.keys().hasOnly(['expenses', 'reports', 'debts', 'gams', 'goals', 'incomes', 'fixed'])
        && prefs.keys().hasAll(['expenses', 'reports', 'debts', 'gams', 'goals', 'incomes', 'fixed'])
        && prefs.expenses is bool
        && prefs.reports is bool
        && prefs.debts is bool
        && prefs.gams is bool
        && prefs.goals is bool
        && prefs.incomes is bool
        && prefs.fixed is bool;
    }

    function validMemberProfile(uid) {
      return request.resource.data.keys().hasOnly(['uid', 'name', 'sharePrefs', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24
        && validSharePrefs(request.resource.data.sharePrefs)
        && request.resource.data.updatedAt == request.time;
    }

    match /spaces/{code} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['owner', 'memberIds', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow get: if isSpaceMember(code);
      allow list: if false;

      function ownerAddsApprovedMember() {
        let before = resource.data;
        let after = request.resource.data;
        let newUid = after.lastApprovedUid;
        let reqPath = requestPath(code, newUid);
        return signedIn()
          && before.owner == request.auth.uid
          && before.memberIds is list
          && after.memberIds is list
          && after.diff(before).affectedKeys().hasOnly(['memberIds', 'lastApprovedUid', 'lastApprovedAt'])
          && after.memberIds.hasAll(before.memberIds)
          && after.memberIds.size() == before.memberIds.size() + 1
          && !before.memberIds.hasAny([newUid])
          && after.memberIds.hasAny([newUid])
          && after.memberIds.size() <= 5
          && newUid is string
          && after.lastApprovedAt == request.time
          && exists(reqPath)
          && get(reqPath).data.status == 'pending'
          && getAfter(reqPath).data.status == 'approved'
          && getAfter(reqPath).data.uid == newUid
          && getAfter(reqPath).data.resolvedBy == request.auth.uid;
      }

      // The owner removes another member (the owner stays in the list).
      function ownerRemovesMember() {
        let before = resource.data;
        let after = request.resource.data;
        return signedIn()
          && before.owner == request.auth.uid
          && before.memberIds is list
          && after.memberIds is list
          && after.diff(before).affectedKeys().hasOnly(['memberIds'])
          && before.memberIds.hasAll(after.memberIds)
          && after.memberIds.size() == before.memberIds.size() - 1
          && after.memberIds.hasAny([request.auth.uid]);
      }

      // A regular member leaves. The owner may only leave this way when he is the last member
      // (otherwise he must transfer ownership: see ownerLeavesAndTransfers).
      function memberLeavesOwnMembership() {
        let before = resource.data;
        let after = request.resource.data;
        return signedIn()
          && before.memberIds is list
          && after.memberIds is list
          && after.diff(before).affectedKeys().hasOnly(['memberIds'])
          && before.memberIds.hasAny([request.auth.uid])
          && !after.memberIds.hasAny([request.auth.uid])
          && before.memberIds.hasAll(after.memberIds)
          && before.memberIds.size() == after.memberIds.size() + 1
          && (before.owner != request.auth.uid || before.memberIds.size() == 1);
      }

      // The owner leaves and hands the space to another current member in the same update.
      function ownerLeavesAndTransfers() {
        let before = resource.data;
        let after = request.resource.data;
        return signedIn()
          && before.owner == request.auth.uid
          && before.memberIds is list
          && after.memberIds is list
          && after.diff(before).affectedKeys().hasOnly(['memberIds', 'owner'])
          && after.owner is string
          && after.owner != request.auth.uid
          && after.memberIds.hasAny([after.owner])
          && !after.memberIds.hasAny([request.auth.uid])
          && before.memberIds.hasAll(after.memberIds)
          && before.memberIds.size() == after.memberIds.size() + 1;
      }

      // Shape and size checks for a shared expense (or its deletion marker)
      function validExpense() {
        let d = request.resource.data;
        return d.upd == request.time && (
          (d.keys().hasOnly(['del', 'upd', 'by'])
            && d.keys().hasAll(['del', 'upd', 'by'])
            && d.del == true
            && d.by is string && d.by.size() <= 128)
          || (d.keys().hasOnly(['amount', 'cat', 'note', 'pay', 'ts', 'by', 'byName', 'del', 'upd'])
              && d.keys().hasAll(['amount', 'cat', 'note', 'ts', 'by', 'byName', 'del', 'upd'])
              && d.del == false
              && d.amount is number
              && d.amount > 0
              && d.amount < 10000000000
              && d.cat is string && d.cat.size() <= 32
              && d.note is string && d.note.size() <= 200
              && d.ts is number
              && d.ts > 0
              && d.by is string && d.by.size() <= 128
              && d.byName is string && d.byName.size() <= 40
              && (!d.keys().hasAny(['pay']) || (d.pay is string && d.pay.size() <= 32)))
        );
      }

      allow update: if isSpaceMember(code)
        && (ownerAddsApprovedMember() || memberLeavesOwnMembership() || ownerLeavesAndTransfers() || ownerRemovesMember());
      allow delete: if false;

      match /members/{memberUid} {
        allow get, list: if isSpaceMember(code);

        function createsOwnerProfileWithSpace() {
          let afterSpace = getAfter(spacePath(code)).data;
          return request.auth.uid == memberUid
            && afterSpace.owner == request.auth.uid
            && afterSpace.memberIds is list
            && afterSpace.memberIds.hasAny([memberUid]);
        }

        allow create: if signedIn()
          && request.auth.uid == memberUid
          && validMemberProfile(memberUid)
          && (isSpaceMember(code) || createsOwnerProfileWithSpace());

        allow update: if signedIn()
          && request.auth.uid == memberUid
          && isSpaceMember(code)
          && resource.data.uid == memberUid
          && validMemberProfile(memberUid);

        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isSpaceMember(code);
        allow create: if isSpaceMember(code)
          && validId(expenseId)
          && validExpense()
          && request.resource.data.del == false
          && request.resource.data.by == request.auth.uid;
        // A shared expense and its deletion marker can only be changed by its author.
        allow update: if isSpaceMember(code)
          && validId(expenseId)
          && resource.data.by == request.auth.uid
          && request.resource.data.by == resource.data.by
          && validExpense();
        allow delete: if isSpaceMember(code)
          && resource.data.by == request.auth.uid;
      }

      match /sharedData/{kind}/items/{itemId} {
        function supportedKind() {
          return kind in ['reports', 'debts', 'gams', 'goals', 'incomes', 'fixed'];
        }

        // Kinds that every member who enabled them can edit and delete (reports stay owner-only)
        function twoWayKind() {
          return kind in ['debts', 'gams', 'goals', 'incomes', 'fixed'];
        }

        function memberEnabledThisKind() {
          return isSpaceMember(code)
            && exists(memberPath(code, request.auth.uid))
            && get(memberPath(code, request.auth.uid)).data.sharePrefs is map
            && get(memberPath(code, request.auth.uid)).data.sharePrefs[kind] == true;
        }

        function validSharedFields() {
          return request.resource.data.keys().hasOnly(['kind', 'localId', 'ownerUid', 'ownerName', 'payload', 'updatedAt'])
            && request.resource.data.kind == kind
            && request.resource.data.localId is string
            && request.resource.data.localId.matches('^[A-Za-z0-9_-]{1,120}$')
            && itemId.matches('^[A-Za-z0-9_-]{1,160}$')
            && request.resource.data.ownerUid is string
            && request.resource.data.ownerName is string
            && request.resource.data.ownerName.size() <= 40
            && request.resource.data.payload is map
            && request.resource.data.payload.size() <= 60
            && request.resource.data.updatedAt == request.time;
        }

        allow read: if isSpaceMember(code);

        // A new record: the creator is the writer
        allow create: if supportedKind()
          && memberEnabledThisKind()
          && validSharedFields()
          && request.resource.data.ownerUid == request.auth.uid;

        // Editing: the creator (ownerUid) never changes; two-way kinds can be edited by any member who enabled them
        allow update: if supportedKind()
          && memberEnabledThisKind()
          && validSharedFields()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && (twoWayKind() || resource.data.ownerUid == request.auth.uid);

        allow delete: if supportedKind()
          && isSpaceMember(code)
          && (resource.data.ownerUid == request.auth.uid
            || (twoWayKind() && memberEnabledThisKind()));
      }

      match /joinRequests/{requestUid} {
        allow get: if signedIn()
          && (request.auth.uid == requestUid || isSpaceOwner(code));
        allow list: if isSpaceOwner(code);

        allow create: if signedIn()
          && request.auth.uid == requestUid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'status', 'sharePrefs', 'requestedAt'])
          && request.resource.data.uid == request.auth.uid
          && validJoinName(request.resource.data.name)
          && validSharePrefs(request.resource.data.sharePrefs)
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedAt == request.time
          && spaceExists(code)
          && get(spacePath(code)).data.memberIds is list
          && !get(spacePath(code)).data.memberIds.hasAny([request.auth.uid])
          && get(spacePath(code)).data.memberIds.size() < 5;

        function requesterRetriesRequest() {
          let before = resource.data;
          let after = request.resource.data;
          let members = get(spacePath(code)).data.memberIds;
          return signedIn()
            && request.auth.uid == requestUid
            && before.uid == request.auth.uid
            && before.status in ['rejected', 'cancelled', 'approved', 'removed']
            && after.keys().hasOnly(['uid', 'name', 'status', 'sharePrefs', 'requestedAt'])
            && after.uid == request.auth.uid
            && validJoinName(after.name)
            && validSharePrefs(after.sharePrefs)
            && after.status == 'pending'
            && after.requestedAt == request.time
            && spaceExists(code)
            && members is list
            && !members.hasAny([request.auth.uid])
            && members.size() < 5;
        }

        function requesterCancelsRequest() {
          let before = resource.data;
          let after = request.resource.data;
          return signedIn()
            && request.auth.uid == requestUid
            && before.uid == request.auth.uid
            && before.status == 'pending'
            && after.diff(before).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt'])
            && after.status == 'cancelled'
            && after.resolvedBy == request.auth.uid
            && after.resolvedAt == request.time;
        }

        function ownerResolvesRequest() {
          let before = resource.data;
          let after = request.resource.data;
          let spaceAfter = getAfter(spacePath(code)).data;
          return isSpaceOwner(code)
            && before.uid == requestUid
            && before.status == 'pending'
            && after.diff(before).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt'])
            && after.uid == before.uid
            && after.name == before.name
            && (!before.keys().hasAny(['sharePrefs'])
              || (after.keys().hasAny(['sharePrefs']) && after.sharePrefs == before.sharePrefs))
            && after.requestedAt == before.requestedAt
            && after.resolvedBy == request.auth.uid
            && after.resolvedAt == request.time
            && (after.status == 'rejected'
              || (after.status == 'approved'
                && spaceAfter.memberIds is list
                && spaceAfter.memberIds.hasAny([requestUid])
                && spaceAfter.lastApprovedUid == requestUid));
        }

        // Marks the request of a member the owner just removed (same batch as the memberIds update),
        // so the removed member's phone knows why it lost access.
        function ownerMarksRemoved() {
          let before = resource.data;
          let after = request.resource.data;
          return isSpaceOwner(code)
            && before.uid == requestUid
            && before.status == 'approved'
            && after.diff(before).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt'])
            && after.status == 'removed'
            && after.resolvedBy == request.auth.uid
            && after.resolvedAt == request.time
            && !getAfter(spacePath(code)).data.memberIds.hasAny([requestUid]);
        }

        allow update: if requesterRetriesRequest()
          || requesterCancelsRequest()
          || ownerResolvesRequest()
          || ownerMarksRemoved();
        allow delete: if false;
      }
    }
  }
}
